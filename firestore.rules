rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CHANGE THIS to the email of the admin user you create in Firebase Authentication.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'rkranjanclassesara@gmail.com';
    }
    function signedIn() { return request.auth != null; }
    function student(id) { return get(/databases/$(database)/documents/students/$(id)).data; }
    function owns(id) {
      return signedIn() && student(id).uid == request.auth.uid && student(id).active == true;
    }

    // Used only to turn a Student ID into the hidden login email. One document at a time, no listing.
    match /loginmap/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if isAdmin() || owns(id);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        owns(id)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['xp','streak','lastDay','tests','correct','attempted','badges','best','updatedAt'])
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= 500
      );

      match /results/{rid} {
        allow read: if isAdmin() || owns(id);
        allow create: if owns(id)
          && request.resource.data.n is int && request.resource.data.n > 0 && request.resource.data.n <= 60
          && request.resource.data.score <= request.resource.data.n;
        allow update, delete: if isAdmin();
      }
    }

    // Public part of a profile for the class leaderboard. No phone number here.
    match /board/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        owns(id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp','tests','streak','updatedAt'])
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= 500
      );
    }
  }
}
